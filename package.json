{
  "name": "japan-clarity",
  "version": "1.0.0-rc.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:research": "bun run scripts/validate-research.ts",
    "export:static": "DEPLOY_TARGET=github-pages next build && bun run scripts/post-export.ts",
    "verify:export": "bun run scripts/verify-export.ts",
    "generate:chapter-data": "bun run scripts/generate-chapter-data.ts",
    "extract:series": "python3 research/chapter01/scripts/extract-series.py"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
